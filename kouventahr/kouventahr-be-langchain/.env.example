DATABASE_URL=aac
OLLAMA_HOST=ha
EMBED_MODEL=a
CHAT_MODEL=a
RETRIEVER_K=a
CHUNK_SIZE=a
CHUNK_OVERLAP=aa
PORT=a

# Azure OpenAI (entity extraction for the knowledge graph)
AZURE_OPENAI_API_KEY=a
AZURE_OPENAI_API_INSTANCE_NAME=a
AZURE_OPENAI_API_DEPLOYMENT_NAME=a
AZURE_OPENAI_API_VERSION=a
OPENAI_API_VERSION=a
OPENAI_CHAT_MODEL=a

# One Neo4j Community container per tenant. Each tenant's password lives only here (never in the tenants
# table, which stores just the variable NAME). Pattern: TENANT_<SLUG>_NEO4J_PASSWORD, dashes become underscores.
TENANT_A_NEO4J_PASSWORD=change-me
TENANT_B_NEO4J_PASSWORD=change-me

# Hybrid retriever: give up on the graph after this many ms and answer from vector search only
GRAPH_TIMEOUT_MS=8000
# Extra source chunks pulled in via the graph (chunks that mention the matched entities), de-duplicated against the vector top-k. 0 = off
GRAPH_CHUNK_K=3
# Graph menu: how many chunks are sent to the AI in parallel while building a graph
GRAPH_BUILD_CONCURRENCY=3
# Entity types hinted to the question entity extractor
GRAPH_ENTITY_TYPES=Regulation, Organization, Obligation, Process

# Agent: Neo4j MCP server (see mcp.json). The URI and credentials it queries with come from the tenant's row.
NEO4J_MCP_URL=http://localhost:8787/db/neo4j/mcp
